{% if component.coupon_code %}<section component-id="{{ componentId }}" class="fourbest-section"><div class="container"><div class="fourbest-promo"><div><span class="fourbest-eyebrow">عرض المتجر</span><h2>{{ component.heading ?: 'خصم على طلبك الأول' }}</h2><p>{{ component.description ?: 'أدخل الرمز في خانة الكوبون عند إتمام الطلب، وفق شروط العرض المعروضة في المتجر.' }}</p></div><div class="fourbest-promo__action"><span>رمز الخصم</span><strong dir="ltr">{{ component.coupon_code }}</strong>{% if component.button_url %}<a class="fourbest-button" href="{{ component.button_url }}">{{ component.button_label ?: 'تسوق الآن' }}</a>{% endif %}</div></div></div></section>{% endif %}
